{
  "name": "@asguho/schema-xml",
  "version": "0.3.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts"
  },
  "imports": {
    "zod": "npm:zod@^4.4.3",
    "fast-xml-parser": "npm:fast-xml-parser@^5.10.1",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "tasks": {
    "check": "deno check src/mod.ts",
    "test": "deno test",
    "test:coverage": "deno test --coverage=coverage && deno coverage coverage",
    "test:node": "./scripts/node_consumer_test.sh",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "verify": "deno task fmt:check && deno task lint && deno task check && deno task test",
    "pack:dry": "deno pack --dry-run",
    "pack": "./scripts/pack_npm.sh",
    "prepublish": "deno task verify && deno task pack:dry"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "README.md",
      "RELEASING.md",
      "LICENSE",
      "CHANGELOG.md"
    ]
  },
  "exclude": [
    "dist/",
    "coverage/"
  ]
}
